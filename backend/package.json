{
  "name": "integrated-waste-epr-backend",
  "version": "1.0.0",
  "description": "Backend API for Integrated Waste Verification & EPR Compliance System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "migrate": "node src/scripts/migrate.js",
    "migrate:up": "node src/scripts/migrate.js up",
    "migrate:postgres": "node src/scripts/migrate.js postgres",
    "migrate:mongo": "node src/scripts/migrate.js mongo",
    "migrate:rollback": "node src/scripts/migrate.js rollback",
    "migrate:status": "node src/scripts/migrate.js status",
    "migrate:stats": "node src/scripts/migrate.js stats",
    "migrate:reset": "node src/scripts/migrate.js reset",
    "test:postgres": "node src/scripts/check_postgres.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "pg": "^8.11.3",
    "sequelize": "^6.35.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "redis": "^4.6.11",
    "socket.io": "^4.7.4",
    "ipfs-http-client": "^60.0.1",
    "ethers": "^6.8.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.33.0",
    "winston": "^3.11.0",
    "aws-sdk": "^2.1498.0",
    "puppeteer": "^21.6.1",
    "pdfkit": "^0.14.0",
    "tesseract.js": "^5.0.3",
    "bull": "^4.12.2",
    "stripe": "^14.9.0",
    "nodemailer": "^6.9.7",
    "cron": "^3.1.6",
    "elasticsearch": "^16.7.3",
    "commander": "^11.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}