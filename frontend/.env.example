# API Configuration
REACT_APP_AI_API_URL=http://localhost:8001/api
REACT_APP_EPR_API_URL=http://localhost:8002/api
REACT_APP_BLOCKCHAIN_API_URL=http://localhost:8003/api
REACT_APP_AUTH_API_URL=http://localhost:8000/api/auth

# Mock Configuration (set to 'true' to use mock APIs)
REACT_APP_USE_MOCK_AI=true
REACT_APP_USE_MOCK_EPR=true
REACT_APP_USE_MOCK_BLOCKCHAIN=true
REACT_APP_USE_MOCK_AUTH=true

# API Client Configuration
REACT_APP_API_TIMEOUT=10000
REACT_APP_API_RETRIES=3

# Development Configuration
REACT_APP_ENABLE_DEV_TOOLS=true
REACT_APP_LOG_LEVEL=debug

# Feature Flags
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true