# Environment Configuration for Delhi Waste Management System
# Copy this file to .env.local and configure your settings

# ====================
# API Configuration
# ====================

# Base URLs for different services
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_AI_API_URL=http://localhost:8001/api
REACT_APP_EPR_API_URL=http://localhost:3001/api/epr
REACT_APP_BLOCKCHAIN_API_URL=http://localhost:3002/api
REACT_APP_AUTH_API_URL=http://localhost:3001/api/auth

# API Client Settings
REACT_APP_API_TIMEOUT=10000
REACT_APP_API_RETRIES=3

# ====================
# Mock Client Toggles
# ====================
# Set to 'true' to use mock clients instead of real APIs
# Useful for development and testing when backend services are not available

REACT_APP_USE_MOCK_AI=true
REACT_APP_USE_MOCK_EPR=true
REACT_APP_USE_MOCK_BLOCKCHAIN=true
REACT_APP_USE_MOCK_AUTH=true

# ====================
# Authentication
# ====================
REACT_APP_JWT_SECRET=your-jwt-secret-key
REACT_APP_SESSION_TIMEOUT=86400000

# ====================
# Blockchain Configuration
# ====================
REACT_APP_BLOCKCHAIN_NETWORK=polygon-mumbai
REACT_APP_BLOCKCHAIN_NETWORK_ID=80001
REACT_APP_INFURA_PROJECT_ID=your-infura-project-id
REACT_APP_WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id

# Smart Contract Addresses (Polygon Mumbai Testnet)
REACT_APP_WASTE_CERTIFICATE_CONTRACT=0x...
REACT_APP_WASTE_TOKEN_CONTRACT=0x...
REACT_APP_STAKING_CONTRACT=0x...
REACT_APP_DAO_CONTRACT=0x...

# ====================
# IPFS Configuration
# ====================
REACT_APP_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
REACT_APP_PINATA_API_KEY=your-pinata-api-key
REACT_APP_PINATA_SECRET_KEY=your-pinata-secret-key

# ====================
# External Services
# ====================
# Google Vision API for OCR
REACT_APP_GOOGLE_VISION_API_KEY=your-google-vision-api-key

# Maps and Location Services
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/*,application/pdf

# ====================
# Feature Flags
# ====================
# Enable/disable specific features
REACT_APP_ENABLE_BLOCKCHAIN=true
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_EPR_COMPLIANCE=true
REACT_APP_ENABLE_QUANTUM_FEATURES=false
REACT_APP_ENABLE_DEFI_FEATURES=false

# Development Features
REACT_APP_ENABLE_DEBUG_MODE=true
REACT_APP_ENABLE_API_MONITORING=true
REACT_APP_SHOW_API_STATUS=true

# ====================
# UI Configuration
# ====================
REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_ENABLE_PWA=true

# ====================
# Monitoring and Analytics
# ====================
REACT_APP_SENTRY_DSN=your-sentry-dsn
REACT_APP_GA_TRACKING_ID=your-google-analytics-id

# ====================
# Development Settings
# ====================
# Only used in development mode
GENERATE_SOURCEMAP=true
BROWSER=none
PORT=5173

# ====================
# Production Settings
# ====================
# These are typically set by your deployment platform
# PUBLIC_URL=https://your-domain.com
# BUILD_PATH=build
# CI=true