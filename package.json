{
  "name": "advanced-waste-management-system",
  "version": "1.0.0",
  "description": "Revolutionary waste management system with AI and IoT integration",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "dev:frontend": "cd frontend && npm run dev",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && python -m pytest",
    "build:frontend": "cd frontend && npm run build",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "clean": "npm run clean:frontend",
    "clean:frontend": "cd frontend && rm -rf node_modules dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/advanced-waste-management-system.git"
  },
  "keywords": [
    "waste-management",
    "ai",
    "iot",
    "sustainability",
    "analytics",
    "machine-learning",
    "automation"
  ],
  "author": "Advanced Waste Management Team",
  "license": "MIT"
}